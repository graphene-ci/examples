# The full example's cluster — copy to .env and fill in.
# cluster.sh sources this file; every value can also come from the
# process environment.

# --- the cluster -------------------------------------------------------
# kind cluster name.
KIND_CLUSTER=graphene-example
# Pinned versions — bumping one is an explicit edit, never latest.
CROSSPLANE_VERSION=1.20.0
PROVIDER_YC_PACKAGE=xpkg.upbound.io/yandexcloud/crossplane-provider-yc
PROVIDER_YC_VERSION=v0.14.0

# --- Yandex Cloud ------------------------------------------------------
# The service account's AUTHORIZED KEY json:
#   yc iam key create --service-account-name <sa> --output sa-key.json
# The SA needs rights to create vpc/compute resources in the folder.
YC_SA_KEY_FILE=./sa-key.json
YC_CLOUD_ID=
YC_FOLDER_ID=

# --- graphene wiring ---------------------------------------------------
# graphenectl context to store the pipeline secrets into ("kubeconfig",
# "bare-ssh-key"). Empty skips the wiring — cluster-only mode.
GRAPHENE_CONTEXT=dev
# Optional: the private key for the example's bare machine
# (NewAgentViaSSH); stored as the "bare-ssh-key" secret when set.
BARE_SSH_KEY_FILE=
